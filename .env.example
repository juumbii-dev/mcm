# Neon dev branch connection string. Keep the real value in Vercel Environment Variables.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
NODE_ENV=development
PORT=8000
# Ably API key in the form app.keyName:secret. Keep this only in environment variables.
ABLY_API_KEY=app.keyName:secret
# Optional separate HMAC secret for guest chat tokens.
CHAT_GUEST_SECRET=replace-with-a-random-secret