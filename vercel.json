{
  "version": 2,
  "routes": [
    { "src": "/api/psychologists", "dest": "/api/psychologists" },
    { "src": "/api/psychologists/(.*)", "dest": "/api/psychologists" },
    { "src": "/api/bookings", "dest": "/api/bookings" },
    { "src": "/api/admin/users", "dest": "/api/db-admin" },
    { "src": "/api/auth", "dest": "/api/auth" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
