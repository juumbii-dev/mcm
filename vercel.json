{
  "version": 2,
  "routes": [
    { "src": "/api/psychologists", "dest": "/api/psychologists" },
    { "src": "/api/psychologists/(.*)", "dest": "/api/psychologists" },
    { "src": "/api/therapist-profiles", "dest": "/api/db-therapist-profiles" },
    { "src": "/api/therapist-profiles/(.*)", "dest": "/api/db-therapist-profiles?id=$1" },
    { "src": "/api/chat", "dest": "/api/db-chat" },
    { "src": "/api/chat/(.*)", "dest": "/api/db-chat" },
    { "src": "/api/ably/token", "dest": "/api/ably-token" },
    { "src": "/chat/([0-9]+)", "dest": "/pages/chat-thread.html?id=$1" },
    { "src": "/chat", "dest": "/pages/chat.html" },
    { "src": "/therapist-login", "dest": "/pages/therapist-login.html" },
    { "src": "/therapist-signup", "dest": "/pages/therapist-signup.html" },
    { "src": "/therapist/profile", "dest": "/pages/therapist-profile.html" },
    { "src": "/therapist/messages", "dest": "/pages/therapist-messages.html" },
    { "src": "/admin-dashboard", "dest": "/pages/admin-dashboard.html" },
    { "src": "/api/bookings", "dest": "/api/bookings" },
    { "src": "/api/admin/users", "dest": "/api/db-admin" },
    { "src": "/api/auth", "dest": "/api/auth" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
